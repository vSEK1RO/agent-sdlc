{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "read", "resource": "ASSIGNMENT.md", "effect": "deny" },
    { "action": "read", "resource": "*ASSIGNMENT.md", "effect": "deny" },
    { "action": "edit", "resource": "ASSIGNMENT.md", "effect": "deny" },
    { "action": "edit", "resource": "*ASSIGNMENT.md", "effect": "deny" },
    { "action": "read", "resource": ".ASSIGNMENT.md.swp", "effect": "deny" },
    { "action": "edit", "resource": ".ASSIGNMENT.md.swp", "effect": "deny" },
    { "action": "shell", "resource": "*ASSIGNMENT*", "effect": "deny" }
  ]
}
